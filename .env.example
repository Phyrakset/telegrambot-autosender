# Telegram API Credentials
# Get them from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here

# The phone number of your Telegram account used for sending (with international code, e.g., +855961234567)
TELEGRAM_PHONE=+855XXXXXXXX

# Default country code ISO for numbers in phone-list.txt without country code (e.g. KH for Cambodia, US, TH, etc.)
DEFAULT_COUNTRY=KH

# Safe delay settings between messages (in seconds) to prevent anti-spam flood triggers
MIN_DELAY_SECONDS=15
MAX_DELAY_SECONDS=35
